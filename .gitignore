# ClaudeKit Dashboard — publish-safety gitignore
#
# The site is PUBLIC (GitHub Pages). Two different things must not be confused:
#
#   data/details.js  — DERIVED metadata: flag names + one-line meanings, example command
#                      lines, the description, the when-to-use section. Published, on purpose:
#                      it is what makes a card's detail view useful. ~145 KB.
#
#   scripts/.cache/  — the marketing kit's RAW source files, verbatim (~1.1 MB, 221 files).
#   .claude/         — the engineer kit's RAW source files (~363 MB).
#                      These ARE the paid product. Never publish them.
#
# The build script reads the raw files in place and writes only the derived file.
# NO negation rules here — audit with `git ls-files` before any push.

# Paid kits — raw source. Never published.
.claude/
scripts/.cache/
release-manifest.json
.repomixignore

# Internal plans & docs (reports reference the private marketing repo)
plans/
docs/

# Node
node_modules/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Env & secrets
.env*
*.pem
